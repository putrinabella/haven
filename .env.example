# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Rotate any credential that was ever committed (see README "Secrets").

# --- Database (Neon Postgres) ---
# Used by the app (neon-http driver) and by drizzle-kit migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Pooled connection string (use if you move to a pooled/WebSocket driver for transactions).
DATABASE_URL_POOLED=

# --- Neon Auth (Better Auth) ---
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-URL
# >= 32 chars. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Optional / not wired up yet ---
# Public origin of the app, only needed if the client calls absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
# Realtime
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
